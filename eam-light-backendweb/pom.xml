<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>ch.cern.cmms</groupId>
		<artifactId>eam-light-backend</artifactId>
		<version>4.1.56-SNAPSHOT</version>
	</parent>

	<artifactId>eam-light-backendweb</artifactId>
	<packaging>jar</packaging>

	<dependencies>
		<dependency>
			<groupId>ch.cern.cmms</groupId>
			<artifactId>eam-light-backendejb</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>ch.cern.cmms</groupId>
			<artifactId>eam-light-interfaces</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.11.2</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.11.2</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.11.2</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.keycloak</groupId>
			<artifactId>keycloak-core</artifactId>
			<version>11.0.2</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.google.code.maven-replacer-plugin</groupId>
				<artifactId>replacer</artifactId>
				<version>1.5.3</version>
				<executions>
					<execution>
						<phase>initialize</phase>
						<goals>
							<goal>replace</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<includes>
						<include>${basedir}/src/main/java/**/*.java</include>
					</includes>
					<excludes>
						<exclude>**/EamLightApplication.java</exclude>
						<exclude>**/EAMLightController.java</exclude>
						<exclude>**/EAMLightNativeRestController.java</exclude>
						<exclude>**/Monitoring.java</exclude>
						<exclude>**/ProxyController.java</exclude>
						<exclude>**/GridController.java</exclude>
					</excludes>
					<regex>true</regex>
					<replacements>
						<!-- Imports -->
						<replacement>
							<token>import javax.ws.rs.GET;</token>
							<value>import org.springframework.web.bind.annotation.GetMapping;</value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.POST;</token>
							<value>import org.springframework.web.bind.annotation.PostMapping;</value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.PUT;</token>
							<value>import org.springframework.web.bind.annotation.PutMapping;</value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.DELETE;</token>
							<value>import org.springframework.web.bind.annotation.DeleteMapping;</value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.Path;</token>
							<value>import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;</value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.Produces;</token>
							<value></value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.Consumes;</token>
							<value></value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.PathParam;</token>
							<value>import org.springframework.web.bind.annotation.PathVariable;</value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.QueryParam;</token>
							<value>import org.springframework.web.bind.annotation.RequestParam;</value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.core.Response;</token>
							<value>import org.springframework.http.ResponseEntity;
import org.springframework.http.HttpStatus;</value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.core.Context;</token>
							<value></value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.core.\*;</token>
							<value>import org.springframework.http.*;
import org.springframework.web.bind.annotation.*;</value>
						</replacement>
						<replacement>
							<token>import javax.ws.rs.\*;</token>
							<value>import org.springframework.web.bind.annotation.*;
import org.springframework.http.ResponseEntity;
import org.springframework.http.HttpStatus;</value>
						</replacement>
						<replacement>
							<token>import javax.inject.Inject;</token>
							<value>import org.springframework.beans.factory.annotation.Autowired;</value>
						</replacement>
						<replacement>
							<token>import javax.enterprise.context.ApplicationScoped;</token>
							<value>import org.springframework.stereotype.Component;</value>
						</replacement>
						<replacement>
							<token>import javax.interceptor.Interceptors;</token>
							<value></value>
						</replacement>
						
						<!-- Annotations -->
						<replacement>
							<token>@Path\("([^"]+)"\)\s*@ApplicationScoped</token>
							<value>@RestController
@RequestMapping("$1")</value>
						</replacement>
						<replacement>
							<token>@Path\("([^"]+)"\)\s*@Interceptors\([^)]+\)\s*@ApplicationScoped</token>
							<value>@RestController
@RequestMapping("$1")</value>
						</replacement>
						<replacement>
							<token>@Path\("([^"]+)"\)</token>
							<value>@RequestMapping("$1")</value>
						</replacement>
						<replacement>
							<token>@GET\s*@Path\("([^"]+)"\)</token>
							<value>@GetMapping("$1")</value>
						</replacement>
						<replacement>
							<token>@POST\s*@Path\("([^"]+)"\)</token>
							<value>@PostMapping("$1")</value>
						</replacement>
						<replacement>
							<token>@PUT\s*@Path\("([^"]+)"\)</token>
							<value>@PutMapping("$1")</value>
						</replacement>
						<replacement>
							<token>@DELETE\s*@Path\("([^"]+)"\)</token>
							<value>@DeleteMapping("$1")</value>
						</replacement>
						<replacement>
							<token>@GET</token>
							<value>@GetMapping</value>
						</replacement>
						<replacement>
							<token>@POST</token>
							<value>@PostMapping</value>
						</replacement>
						<replacement>
							<token>@PUT</token>
							<value>@PutMapping</value>
						</replacement>
						<replacement>
							<token>@DELETE</token>
							<value>@DeleteMapping</value>
						</replacement>
						<replacement>
							<token>@Produces\([^)]+\)</token>
							<value></value>
						</replacement>
						<replacement>
							<token>@Consumes\([^)]+\)</token>
							<value></value>
						</replacement>
						<replacement>
							<token>@PathParam\((value\s*=\s*)?"([^"]+)"\)</token>
							<value>@PathVariable("$2")</value>
						</replacement>
						<replacement>
							<token>@QueryParam\((value\s*=\s*)?"([^"]+)"\)</token>
							<value>@RequestParam("$2")</value>
						</replacement>
						<replacement>
							<token>@Inject</token>
							<value>@Autowired</value>
						</replacement>
						<replacement>
							<token>@ApplicationScoped</token>
							<value>@Component</value>
						</replacement>
						<replacement>
							<token>@Interceptors\([^)]+\)</token>
							<value></value>
						</replacement>
						
						<!-- Return statements and status codes -->
						<replacement>
							<token>\bResponse\.status\(Response\.Status\.OK\)\.entity\((.*?)\)\.build\(\)</token>
							<value>ResponseEntity.ok($1)</value>
						</replacement>
						<replacement>
							<token>\bResponse\.status\(Response\.Status\.NO_CONTENT\)\.build\(\)</token>
							<value>ResponseEntity.noContent().build()</value>
						</replacement>
						<replacement>
							<token>\bResponse\.status\(Response\.Status\.INTERNAL_SERVER_ERROR\)\.entity\((.*?)\)\.build\(\)</token>
							<value>ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body($1)</value>
						</replacement>
						<replacement>
							<token>\bResponse\.status\(Response\.Status\.BAD_REQUEST\)\.entity\((.*?)\)\.build\(\)</token>
							<value>ResponseEntity.status(HttpStatus.BAD_REQUEST).body($1)</value>
						</replacement>
						<replacement>
							<token>\bResponse\.status\(Response\.Status\.FORBIDDEN\)\.entity\((.*?)\)\.build\(\)</token>
							<value>ResponseEntity.status(HttpStatus.FORBIDDEN).body($1)</value>
						</replacement>
						<replacement>
							<token>\bResponse\.Status\.OK\b</token>
							<value>HttpStatus.OK</value>
						</replacement>
						<replacement>
							<token>\bResponse\.Status\.NO_CONTENT\b</token>
							<value>HttpStatus.NO_CONTENT</value>
						</replacement>
						<replacement>
							<token>\bResponse\.Status\.INTERNAL_SERVER_ERROR\b</token>
							<value>HttpStatus.INTERNAL_SERVER_ERROR</value>
						</replacement>
						<replacement>
							<token>\bResponse\.Status\.BAD_REQUEST\b</token>
							<value>HttpStatus.BAD_REQUEST</value>
						</replacement>
						<replacement>
							<token>\bResponse\.Status\.FORBIDDEN\b</token>
							<value>HttpStatus.FORBIDDEN</value>
						</replacement>
						<replacement>
							<token>\bResponse\b</token>
							<value>ResponseEntity&lt;?&gt;</value>
						</replacement>
					</replacements>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>KEYCLOAK</id>
			<properties>
				<webxml.path>src/main/webapp/WEB-INF/cern/web.xml</webxml.path>
			</properties>
		</profile>
		<profile>
			<id>NONE</id>
			<properties>
				<webxml.path>src/main/webapp/WEB-INF/open/web.xml</webxml.path>
			</properties>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
		</profile>
		<profile>
			<id>CERN</id>
			<dependencies>
				<dependency>
					<groupId>ch.cern.cmms</groupId>
					<artifactId>eam-light-cern</artifactId>
					<version>${project.version}</version>
					<scope>provided</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>OPEN</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<dependencies>
				<dependency>
					<groupId>ch.cern.cmms</groupId>
					<artifactId>eam-light-opensource</artifactId>
					<version>${project.version}</version>
					<scope>provided</scope>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
</project>